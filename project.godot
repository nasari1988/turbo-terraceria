; Archivo de configuración del proyecto Godot 4.7

config_version=5

[application]

config/name="Turbo Terracería"
config/description="Juego de carreras arcade para Android (prototipo)."
config/version="0.5.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.29, 0.56, 0.85, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/pantalla_carga.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[physics]

common/physics_interpolation=true
common/physics_ticks_per_second=60
